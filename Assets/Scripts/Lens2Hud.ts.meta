  InputLines:
    - '// @input string source = "replay" {"hint":"T64: replay = the recorded walk and the video (default). live = the Spectacles GPS and compass"}'
    - // @input bool useVideoTexture
    - // @input Asset.Texture video
    - // @input SceneObject videoBackground
    - '// @input string clockMode = "lens" {"hint":"T47 replay clock: lens | frames | stamp (texture when Use Video Texture is on)"}'
