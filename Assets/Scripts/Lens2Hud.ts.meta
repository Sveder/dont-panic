    - '// @input bool showDebug {"hint":"T56: show the replay debug line (t, heading, pitch) at the bottom. Off for every demo"}'
    - '// @input SceneObject viewFlash {"hint":"T30: full-screen image that flashes red when an alarm starts (for a user who cannot hear the siren)"}'
    - '// @input float offset {"hint":"Seconds the video is shifted against the walk track (track t = video t + offset)"}'
    - '// @input float staySeconds = 600 {"hint":"Stay in the shelter countdown, seconds. 600 on the real Lens; set e.g. 20 to see the end in a preview"}'
    - '// @input float paceMps = 1.2 {"hint":"Walking pace for the time check, m/s (1.2 = with two children)"}'
    - '// @input float demoAlertTime = -1 {"hint":"Demo: alert time in seconds instead of the area time (e.g. 20 shows the take-cover line). -1 = area time"}'
    - '// @input float demoSirenAt = -1 {"hint":"Demo (T30): no recorded alert; the siren path raises the alarm at this track time, as if the microphone heard it. -1 = off"}'
    - '// @input bool recordedAlarm {"hint":"T62: true = the alarm time recorded in the track starts the alert. false (default) = only the siren detector (SirenMic) raises the alarm"}'
    - '// @input SceneObject stopButton {"hint":"T62: Stop button image, shown from the alert on"}'
    - '// @input float demoSecondAlarmAt = -1 {"hint":"Demo: a second alarm at this track time restarts the sequence. -1 = off"}'
    - '// @input string alertUrl = "" {"hint":"T65: URL of the alert relay, for example http://<server>/alerts/hfc/ . Empty (default) = no official alert path and no network request"}'
    - '// @input string alertArea = "" {"hint":"T65: Home Front Command area name prefixes, comma separated, for example: תל אביב. Empty = the official alert path stays off"}'
    - '// @input Asset.InternetModule internetModule {"hint":"T65: add an Internet Module asset and wire it here to use the official alert path. See the README about the permission limit"}'
